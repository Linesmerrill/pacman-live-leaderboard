{
  "name": "@pacman/streamdeck",
  "version": "1.0.0",
  "private": true,
  "description": "Stream Deck controller for the Pac-Man Maze attraction: one key per game action.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "install-plugin": "bash scripts/install-plugin.sh",
    "icons": "node --disable-warning=ExperimentalWarning scripts/make-icons.mjs",
    "profile": "node --disable-warning=ExperimentalWarning scripts/make-profile.mjs",
    "test": "node build.mjs && node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "ws": "^8.18.0",
    "@types/ws": "^8.5.12"
  }
}
